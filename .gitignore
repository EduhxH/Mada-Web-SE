# Notas de estudo e de projeto: pessoais, ficam so na maquina
docs/

# Editor
.vscode

# Python — bytecode e caches
__pycache__/
*.py[cod]

# Ambientes virtuais
.venv/
venv/

# Testes
.pytest_cache/
.coverage
htmlcov/

# Dados baixados/gerados: não versionamos conteúdo bruto, só a pasta
data/raw/*
!data/raw/.gitkeep

# Livros e material com direitos de autor: nunca versionar
data/livros/

# Segredos e dados de participantes: NUNCA versionar
.env
data/segredo.txt
data/participantes.json
data/uso.sqlite3
# O modo WAL cria estes ao lado da base de dados, com dados por escrever
*.sqlite3-wal
*.sqlite3-shm

# Bancos de dados locais (SQLite)
*.db
*.sqlite
*.sqlite3

# Arvore de trabalho do ramo gh-pages (pagina de reencaminhamento)
.gh-pages/

# Registo de material novo do Moodle: estado local, nao versionado
data/novidades.json
# Posts da newsletter, media carregada e fotos de perfil: conteudo e dados de
# pessoas desta escola, nao pertencem ao repositorio publico
data/newsletter.json
data/newsletter.json.novo
data/media/
data/perfil/
# Marcas de "ja vi esta secao do painel": preferencia de interface, nao dado
data/painel-visto.json
# Epocas de sessao: estado local de quem foi expulso e quando
data/sessoes-cortadas.json
# Registo do servidor (so avisos e erros; o resto vive em memoria)
data/servidor.log
data/verificacao.log
# Registos rodados pelas tarefas agendadas (scripts/tarefa.py)
*.log.1

# Os codigos de acesso em claro. Sao a unica copia - no servidor so existe o
# HMAC - por isso ficam em ficheiro para nao se perderem ao fechar a consola,
# e apagam-se depois de entregues.
data/codigos-*.txt

# Instantaneos de medicao, regenerados com --guardar
avaliacao/base*.json
data/horario.log
data/horario-estado.json

# HTML temporario das capturas do manual: e so o passo intermedio entre o
# servidor e o PNG, e regenera-se com scripts/capturar_ecras.py
assets/manual/_html/
